{
  "name": "pi-reply-reader",
  "version": "0.2.1",
  "description": "Read a Pi or Gentle Shell reply aloud on request, with local text-to-speech and Markdown cleaned up for listening.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel2010001/pi-reply-reader.git"
  },
  "homepage": "https://github.com/daniel2010001/pi-reply-reader#readme",
  "bugs": {
    "url": "https://github.com/daniel2010001/pi-reply-reader/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "gentle-shell",
    "tts"
  ],
  "pi": {
    "extensions": [
      "./extensions/reply-reader.ts"
    ]
  },
  "bin": {
    "reply-reader": "dist/bin/reply-reader.js"
  },
  "files": [
    "dist",
    "extensions",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2",
    "@earendil-works/pi-tui": ">=1.2.0 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.1"
  }
}
